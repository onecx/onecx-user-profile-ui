{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "outDir": "./dist/test",
    "types": ["jasmine", "node"],
    "useDefineForClassFields": false
  },
  "files": ["src/test.ts", "src/polyfills.ts"],
  "exclude": [
    "src/app/shared/generated/**/*",
    "node_modules",
    "src/test.ts",
    "src/**/*.harness.ts",
    "src/app/shared/mocks/**"
  ],
  "include": ["**/*.spec.ts", "**/*.d.ts"]
}
